		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "https://raw.githubusercontent.com/ConnorPietrasik/pi-raw-context-counter/master/Thumbnail.png"
	},
	"peerDependencies": {
